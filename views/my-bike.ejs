

<!DOCTYPE html>
<html>

<head>
  <title>My Bikes</title>
</head>

<body style="font-family: Arial; background: #f3f4f6; margin: 0;">

  <h1 style="text-align:center; padding: 30px;">
    My Listed Bikes
  </h1>

  <% bikes.forEach(function(bike){ %>

    <div
      style="
        width: 70%;
        margin: 20px auto;
        background: white;
        padding: 20px;
        border-radius: 10px;
        display: flex;
        gap: 20px;
      "
    >

      <img
        src="/images/uploads/<%= bike.image %>"
        style="width: 200px;"
      />

      <div>

        <h2><%= bike.bikeName %></h2>

        <h3 style="color:red;">
          ₹<%= bike.pricePerDay %> / day
        </h3>

        <p>
          <%= bike.description %>
        </p>

        <p>
          <b>Bike Number:</b>
          <%= bike.bikeNumber %>
        </p>
          <a
  href="/edit-bike/<%= bike._id %>"
  style="
    display: inline-block;
    margin-top: 10px;
    padding: 10px 20px;
    background: #2563eb;
    color: white;
    text-decoration: none;
    border-radius: 8px;
  "
>
  Edit Bike
</a>
<a
  href="/delete-bike/<%= bike._id %>"
  style="
    display: inline-block;
    margin-top: 10px;
    margin-left: 10px;
    padding: 10px 20px;
    background: #dc2626;
    color: white;
    text-decoration: none;
    border-radius: 8px;
  "
>
  Delete
</a>
        </div>

    </div>

  <% }) %>

</body>

</html>