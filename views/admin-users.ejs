<!DOCTYPE html>
<html>

<head>
  <title>All Users</title>
</head>

<body style="font-family:Arial;background:#f3f4f6;">

  <h1 style="text-align:center;">
    All Users
  </h1>

  <% users.forEach(function(user){ %>

    <div
      style="
        background:white;
        width:70%;
        margin:20px auto;
        padding:20px;
        border-radius:10px;
      "
    >

      <h2>
        <%= user.name %>
      </h2>

      <p>
        <b>Email:</b>
        <%= user.email %>
      </p>

      <p>
        <b>Role:</b>
        <%= user.role %>
      </p>

    </div>

  <% }) %>

</body>

</html>